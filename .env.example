# Copie este arquivo para .env e preencha os valores para rodar localmente.

PORT=3000
NODE_ENV=development

# Postgres. Localmente, use algo como:
# postgresql://postgres:senha@localhost:5432/cat_empire
# No Render, o valor é preenchido automaticamente pelo render.yaml.
DATABASE_URL=

JWT_SECRET=troque_por_um_valor_aleatorio_e_secreto

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Deve bater exatamente com o "Redirect" cadastrado no app do Discord.
# Ex: https://seu-servico.onrender.com/auth/discord/callback
DISCORD_REDIRECT_URI=

CORS_ORIGIN=*

# ===========================================================================
# Cast externo (transmitir a tela do celular via app tipo Larix Broadcaster)
# ===========================================================================
# Desligado por padrão. Ver seção "Transmissão de tela pelo celular" no
# README antes de ativar — normalmente exige um host separado do Render,
# porque a porta RTMP não fica exposta publicamente num Web Service padrão.
MEDIA_SERVER_ENABLED=false
MEDIA_RTMP_PORT=1935
MEDIA_HTTP_PORT=8000
# URL RTMP pública que o app de transmissão (Larix, OBS, etc) vai usar.
# Ex: rtmp://meu-media-server.exemplo.com:1935
MEDIA_PUBLIC_RTMP_HOST=
# Base HTTP pública de onde o navegador vai tocar o HTTP-FLV do cast.
# Ex: http://meu-media-server.exemplo.com:8000
MEDIA_PUBLIC_HTTP_BASE=
